+pub fn NDIlib_send_advertiser_available() -> bool {
+    if let Some(ffi) = FFI.get() {
+        ffi.send_advertiser_create.is_some()
+            && ffi.send_advertiser_destroy.is_some()
+            && ffi.send_advertiser_add_sender.is_some()
+            && ffi.send_advertiser_del_sender.is_some()
+    } else {
+        false
+    }
+}
+
+pub unsafe fn NDIlib_send_advertiser_create(
+    p_create_settings: *const NDIlib_send_advertiser_create_t,
+) -> NDIlib_send_advertiser_instance_t {
+    if let Some(ref f) = FFI.get_unchecked().send_advertiser_create {
+        f(p_create_settings)
+    } else {
+        ::std::ptr::null_mut()
+    }
+}
+
+pub unsafe fn NDIlib_send_advertiser_destroy(p_instance: NDIlib_send_advertiser_instance_t) {
+    if let Some(ref f) = FFI.get_unchecked().send_advertiser_destroy {
+        f(p_instance)
+    }
+}
+
+pub unsafe fn NDIlib_send_advertiser_add_sender(
+    p_instance: NDIlib_send_advertiser_instance_t,
+    p_sender: NDIlib_send_instance_t,
+    allow_monitoring: bool,
+) -> bool {
+    if let Some(ref f) = FFI.get_unchecked().send_advertiser_add_sender {
+        f(p_instance, p_sender, allow_monitoring)
+    } else {
+        false
+    }
+}
+
+pub unsafe fn NDIlib_send_advertiser_del_sender(
+    p_instance: NDIlib_send_advertiser_instance_t,
+    p_sender: NDIlib_send_instance_t,
+) -> bool {
+    if let Some(ref f) = FFI.get_unchecked().send_advertiser_del_sender {
+        f(p_instance, p_sender)
+    } else {
+        false
+    }
+}
