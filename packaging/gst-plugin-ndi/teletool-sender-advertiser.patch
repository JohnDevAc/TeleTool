+    pub fn advertise(&mut self, allow_monitoring: bool) -> SendAdvertiseResult {
+        if self.advertiser.is_some() {
+            return SendAdvertiseResult::AlreadyAdvertising;
+        }
+        if !NDIlib_send_advertiser_available() {
+            return SendAdvertiseResult::UnsupportedRuntime;
+        }
+
+        let Some(advertiser) = SendAdvertiser::new() else {
+            return SendAdvertiseResult::CreateFailed;
+        };
+
+        if advertiser.add_sender(self, allow_monitoring) {
+            self.advertiser = Some(advertiser);
+            SendAdvertiseResult::Advertising
+        } else {
+            SendAdvertiseResult::AddFailed
+        }
@@ -432 +458,48 @@ impl Drop for SendInstance {
-        unsafe { NDIlib_send_destroy(self.0.as_ptr() as *mut _) }
+        if let Some(advertiser) = self.advertiser.take() {
+            advertiser.del_sender(self);
+        }
+        unsafe { NDIlib_send_destroy(self.ptr.as_ptr() as *mut _) }
+    }
+}
+
+#[derive(Debug, Copy, Clone, PartialEq, Eq)]
+pub enum SendAdvertiseResult {
+    Advertising,
+    AlreadyAdvertising,
+    UnsupportedRuntime,
+    CreateFailed,
+    AddFailed,
+}
+
+#[derive(Debug)]
+struct SendAdvertiser(ptr::NonNull<::std::os::raw::c_void>);
+
+impl SendAdvertiser {
+    fn new() -> Option<Self> {
+        unsafe {
+            let settings = NDIlib_send_advertiser_create_t {
+                p_url_address: ptr::null(),
+            };
+            let ptr = NDIlib_send_advertiser_create(&settings);
+            ptr::NonNull::new(ptr).map(Self)
+        }
+    }
+
+    fn add_sender(&self, send: &SendInstance, allow_monitoring: bool) -> bool {
+        unsafe {
+            NDIlib_send_advertiser_add_sender(
+                self.0.as_ptr(),
+                send.ptr.as_ptr(),
+                allow_monitoring,
+            )
+        }
+    }
+
+    fn del_sender(&self, send: &SendInstance) -> bool {
+        unsafe { NDIlib_send_advertiser_del_sender(self.0.as_ptr(), send.ptr.as_ptr()) }
+    }
+}
+
+impl Drop for SendAdvertiser {
+    fn drop(&mut self) {
+        unsafe { NDIlib_send_advertiser_destroy(self.0.as_ptr() as *mut _) }
